# M4 Mosquitto broker: TLS only, password required, no anonymous clients.
# Rendered to mosquitto.conf (with absolute paths) by gen_certs.py. Start with:
#   mosquitto -c M4/mosquitto/mosquitto.conf -v
per_listener_settings false
allow_anonymous false
password_file {{DIR}}/passwd

# TLS listener (8883). No plain-text 1883 listener is opened at all.
listener 8883
cafile   {{DIR}}/certs/ca.crt
certfile {{DIR}}/certs/server.crt
keyfile  {{DIR}}/certs/server.key
tls_version tlsv1.2

log_type error
log_type warning
log_type notice
log_type information
connection_messages true
