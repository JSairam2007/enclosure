# M5 Linux auto-start (systemd). Edit User and the two paths, then:
#   sudo cp m5/autostart/edgeai.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now edgeai
#   journalctl -u edgeai -f                      # logs
# Test: sudo reboot, then check the dashboard comes back without touching anything.
[Unit]
Description=Edge AI line monitor (dashboard under watchdog)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=/home/REPLACE_USER/edgeai
ExecStart=/home/REPLACE_USER/edgeai/.venv/bin/python m4/watchdog.py --heartbeat m5/status.json --stale-s 20 --restart-on-clean-exit -- python m5/dashboard.py --model models/best_int8.onnx --source 0
Restart=always
RestartSec=5
# give the camera (/dev/video0) and serial (/dev/ttyUSB0) access:
SupplementaryGroups=video dialout

[Install]
WantedBy=multi-user.target
